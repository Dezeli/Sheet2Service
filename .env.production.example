# Copy to .env.production (never committed) and fill in. Run with:
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build

# Django: a long random secret (python3 -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_SECURE=1
# the public address, e.g. sheet2service.example.com (localhost stays for checking on this machine)
DJANGO_ALLOWED_HOSTS=sheet2service.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sheet2service.example.com,http://localhost:8080

# Database: the same values as .env, so the services made during development carry over
POSTGRES_DB=sheet2service
POSTGRES_USER=sheet2service
POSTGRES_PASSWORD=

# Claude (backend only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8000
# 4 digits asked before every Claude call; leave empty to ask nothing
SHEET2SERVICE_GENERATION_PIN=
