{
    "model": "사용할 모델",                 // 필수
    "max_tokens": 1024,                   // 필수
    "messages": [                         // 필수
        {
        "role": "user",
        "content": "Claude에게 보낼 내용"
        }
    ],

    "system": "전체 요청에 적용할 지시문",  // 선택
    "output_config": {
        "format": {
        "type": "json_schema", // json 아니면 text(옵션 생략 시)
        "schema": { /* 원하는 응답 형식 */ }
        },
        "effort": "medium"
    },
    "thinking": { "type": "adaptive" },    // 선택: 확장 사고
    "tools": [ /* 사용 가능한 도구 정의 */ ], // 선택
    "tool_choice": { "type": "auto" },     // 선택: 도구 사용 방식

    "stream": false,                      // 선택: 응답 스트리밍
    "stop_sequences": ["종료 문구"],      // 선택: 생성 중단 문자열
    "service_tier": "auto",               // 선택: 서비스 처리 등급
    "metadata": { "user_id": "익명 ID" }, // 선택: 요청 관련 식별 정보
    "cache_control": { "type": "ephemeral" }, // 선택: 프롬프트 캐시
    "container": { "id": "컨테이너 ID" }, // 선택: 컨테이너 재사용
    "diagnostics": {
        "previous_message_id": "이전 응답 ID"
    }
}
